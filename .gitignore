# ============================================================================
# .gitignore for Harmonic Paradigm research project
# Based on research skill v2.14 template (kaizen fix A4)
# ============================================================================

# --- Ephemeral / JIT scratch scripts (NEVER durable, may contain tokens) ---
_*.py
_*.js
_*.sh
__pycache__/
*.pyc

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Build artifacts (rebuild from source, don't version binaries) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
build/
paper.build.md

# --- Credentials (defense in depth) ---
*.token
*_token
*_secret
.env
.env.*
keys.json

# --- Local-only working files ---
*.tmp
*.bak
~$*
